	(pad 1 smd rect (at -2.30 1.75 0.00) (size 1.700 0.700) (layers F.Cu F.Paste F.Mask))
	(pad 3 smd rect (at -2.30 -1.75 0.00) (size 1.700 0.700) (layers F.Cu F.Paste F.Mask))
	(fp_circle (center -2.50 2.50) (end -2.47 2.50) (layer F.SilkS) (width 0.06))
	(fp_text user + (at -1.52 1.40 0.00) (layer F.SilkS)
